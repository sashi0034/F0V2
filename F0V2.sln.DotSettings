	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=8B20CAD485FD704A98BDBE4346786A42/Text/@EntryValue">namespace $NS$
{
    using namespace Util;

	class $TYPE$ : public ActorHandle
	{
	public:
		$TYPE$();

		void init();

		std::shared_ptr&lt;ActorBase&gt; asActor() const override;

	private:
		struct Impl;
		std::shared_ptr&lt;Impl&gt; p_impl;
	};
}
</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/@KeyIndexDefined">True</s:Boolean>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Applicability/=Live/@EntryIndexedValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Description/@EntryValue">Actor for source file</s:String>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Field/=NS/Expression/@EntryValue">getDefaultNamespace()</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/IsBlessed/@EntryValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Reformat/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Shortcut/@EntryValue">actorcpp</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=BA97F997D3636044BCBD521D921B444D/Text/@EntryValue">using namespace $NS$;

namespace 
{
}

struct $TYPE$::Impl : ActorBase
{
	ActorContainer m_children{};
    $END$
	void init()
	{
	}

	void update() override
	{
		m_children.updateEach();
	}

	void draw() const override
	{
		m_children.drawEach();
	}

	void killed() override
	{
		m_children.killEach();
	}
};

namespace $NS$
{
	$TYPE$::$TYPE$()
		: p_impl(std::make_shared&lt;Impl&gt;())
	{
	}

	void $TYPE$::init()
	{
		p_impl-&gt;init();
	}

	std::shared_ptr&lt;ActorBase&gt; $TYPE$::asActor() const
	{
		return p_impl;
	}
}


</s:String>
