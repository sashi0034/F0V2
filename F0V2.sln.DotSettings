	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=8B20CAD485FD704A98BDBE4346786A42/Scope/=F6696F8185506F41B9C4252540BE9C18/Type/@EntryValue">InCppFile</s:String>
